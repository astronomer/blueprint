# Shared Airflow runtime. Pick the example to run with:
#
#     tilt up -- --example=getting-started
#
# Each example builds from its own directory as the Docker context, exactly as
# a standalone Astro project would.

config.define_string('example')
cfg = config.parse()
example = cfg.get('example', os.getenv('EXAMPLE', 'getting-started'))

example_dir = '../' + example
if not os.path.exists(example_dir + '/dags'):
    fail('No such example: examples/' + example + ' (expected a dags/ directory)')

os.putenv('EXAMPLE', example)
print('Running example: ' + example)

# The compose file mounts this repository's blueprint/ into the containers, so
# edits to the library and to the example's dags/ both take effect on the next
# DAG parse -- no rebuild, and nothing to sync here.
docker_compose('./docker-compose.yaml')

dc_resource('postgres')
dc_resource('db-migration', resource_deps=['postgres'])
dc_resource('api-server', resource_deps=['db-migration'])
dc_resource('scheduler', resource_deps=['db-migration'])
dc_resource('dag-processor', resource_deps=['db-migration'])
dc_resource('triggerer', resource_deps=['db-migration'])

docker_build(
    'blueprint-example-' + example,
    context=example_dir,
    dockerfile=example_dir + '/Dockerfile',
    ignore=['**/logs/**'],
)
