{
  "additionalProperties": false,
  "properties": {
    "target": {
      "description": "Destination table",
      "title": "Target",
      "type": "string"
    },
    "mode": {
      "default": "append",
      "description": "How rows are written",
      "enum": [
        "append",
        "overwrite"
      ],
      "title": "Mode",
      "type": "string"
    },
    "blueprint": {
      "type": "string",
      "const": "load",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "target"
  ],
  "title": "load",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}